# ── Credentials & tokens (NEVER commit) ──────────────────────────────────────
token.json
oauth_client.json
config.json
credientals.json
credentials.json

# Per-client sensitive files
clients/*/config.json
clients/*/token.json
clients/*/oauth_client.json
clients/*/report_data.json
clients/*/nodes_output.txt

# ── All JSON blocked by default; specific files un-ignored below ──────────────
*.json

# Keep these JSON files
!node_map.json
!clients/*/node_map.json
!figma_plugin/manifest.json
!.devcontainer/devcontainer.json

# ── Streamlit secrets ─────────────────────────────────────────────────────────
.streamlit/secrets.toml

# ── Generated / output ────────────────────────────────────────────────────────
report_data.json
nodes_output.txt
data/

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── Docs (local only, README is the exception) ───────────────────────────────
*.md
!README.md

# ── OS / Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/

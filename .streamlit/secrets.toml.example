# Copy this file to .streamlit/secrets.toml and fill in real values.
# On Streamlit Cloud: paste these into the Secrets panel (App Settings → Secrets).
# NEVER commit secrets.toml to git.

# ── Dashboard login ───────────────────────────────────────────────────────────
APP_PASSWORD = "your-strong-password-here"

# ── Figma ─────────────────────────────────────────────────────────────────────
FIGMA_TOKEN = "figd_..."

# ── Google OAuth (GA4) ────────────────────────────────────────────────────────
# Get these from token.json after running `py fetch_ga4.py` locally once.
GOOGLE_CLIENT_ID     = "257004509982-....apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET = "GOCSPX-..."
GOOGLE_REFRESH_TOKEN = "1//0g..."
